{
  "name": "darksite",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time planetarium for dark-sky observers, in a single HTML file.",
  "author": "Tanmay CJ (https://github.com/TanmayCJ)",
  "homepage": "https://tanmaycj.github.io/DarkPlanet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanmayCJ/DarkPlanet.git"
  },
  "bugs": {
    "url": "https://github.com/TanmayCJ/DarkPlanet/issues"
  },
  "license": "MIT",
  "scripts": {
    "fetch": "bash tools/fetch_data.sh",
    "build:data": "python3 tools/build_data.py",
    "build": "python3 tools/assemble.py",
    "build:all": "npm run fetch && npm run build:data && npm run build",
    "check": "node --check src/app.js",
    "serve": "python3 -m http.server 8080 --directory dist",
    "test": "node tools/smoke.js"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=18"
  }
}
